{
  "name": "serverkit-gui",
  "display_name": "ServerKit Agent GUI (Beta)",
  "version": "0.1.0-beta.1",
  "description": "Agent-powered desktop view for managed servers. Streams live Windows/Linux screenshots when available; otherwise describes the server as a surface-v1 desktop of its system, services, containers, processes and storage.",
  "author": "Juan Denis",
  "homepage": "https://github.com/jhd3197/serverkit-gui",
  "repository": "https://github.com/jhd3197/serverkit-gui",
  "license": "MIT",
  "category": "monitoring",
  "entry_point": "blueprint:gui_bp",
  "url_prefix": "/api/v1/server-gui",
  "frontend_entry": "dist/index.mjs",
  "sdk_version": "^1.3.0",
  "requires_agent_actions": [
    "gui:screenshot",
    "gui:capabilities",
    "system:info",
    "system:processes",
    "system:metrics",
    "docker:container:list",
    "docker:container:restart",
    "systemd:list_units",
    "systemd:restart"
  ],
  "minimum_agent_version": "0.4.0",
  "permissions": [
    "agent.command:gui:screenshot",
    "agent.command:gui:capabilities",
    "agent.command:system:info",
    "agent.command:system:processes",
    "agent.command:system:metrics",
    "agent.command:docker:container:list",
    "agent.command:docker:container:restart",
    "agent.command:systemd:list_units",
    "agent.command:systemd:restart"
  ],
  "contributions": {
    "widgets": [
      {
        "slot": "global",
        "component": "default"
      }
    ]
  }
}
